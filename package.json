		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7"
	},
	"dependencies": {
		"@lucide/svelte": "^0.546.0",
		"child_process": "^1.0.2",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"googleapis": "^164.0.0",
		"monaco-editor": "^0.54.0"
